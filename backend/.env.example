# Get these from https://my.telegram.org
TG_API_ID=
TG_API_HASH=

# Folder where Telethon .session files are stored
SESSIONS_DIR=./sessions

# Local/dev database. Production should set DATABASE_URL to PostgreSQL.
DB_URL=sqlite+aiosqlite:///./app.db
DATABASE_URL=

# PostgreSQL pool tuning. Used only when DATABASE_URL is PostgreSQL.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# Defense-in-depth: only one PostgreSQL-backed app replica may control the account set.
ENFORCE_SINGLE_INSTANCE=true

# Fernet key for encrypted Telegram StringSession and remembered 2FA values stored in SQL.
# Keep this as a deployment secret and back it up securely; losing it makes encrypted sessions unreadable.
SECRETS_ENCRYPTION_KEY=

# Default rate limit window (seconds) between bulk actions
RATE_MIN=0.7
RATE_MAX=1.5
# Max in-flight bulk account operations and startup client connects.
CONCURRENCY=8
STARTUP_CONCURRENCY=10

# Maximum duration for one account action inside a bulk job.
TG_RPC_TIMEOUT_SECONDS=45
# Timeout for non-streaming API request handlers.
API_REQUEST_TIMEOUT_SECONDS=60
# Max accounts checked concurrently by the 30s background health loop.
STATUS_CONCURRENCY=10
AUTO_RECONNECT=true
# Frontend preference restored from SQL runtime settings.
NOTIFICATION_SOUND=true
# Exponential reconnect backoff for retryable network failures.
RECONNECT_BACKOFF_BASE_SECONDS=30
RECONNECT_BACKOFF_MAX_SECONDS=900
RECONNECT_BACKOFF_JITTER_RATIO=0.2

# Optional comma-separated cross-origin frontend origins. Same-origin production needs no entry.
ALLOWED_ORIGIN=

# ===== ACCESS PASSWORD (REQUIRED) =====
# Login-page password. Production preflight requires at least 12 chars.
# Store it only as a deployment/environment secret; the value remains present in process environment.
APP_PASSWORD=change-me-to-a-long-strong-password

# How many days the login cookie stays valid
SESSION_DAYS=14

# Login rate limit: max attempts per window
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MIN=15

# Dashboard auth hardening. Set both true behind a trusted HTTPS reverse proxy.
COOKIE_SECURE=false
TRUST_PROXY_HEADERS=false
# Comma-separated additional browser origins allowed for cookie-authenticated writes.
CSRF_TRUSTED_ORIGINS=

PENDING_LOGIN_TTL_SECONDS=600
QR_PENDING_TTL_SECONDS=600

# Logging: production defaults to JSON on stdout for platform log collection.
LOG_LEVEL=INFO
# Optional override: json or text. Leave empty to auto-select from NODE_ENV.
LOG_FORMAT=
